// comment

//name of factory
#name SanFeng01

// 0: frontwheel drive  1: rearwheel drive,  2: 4-wheel drive
#drivewheel 0

// 0:  not HardWare detect charging, 1: HardWare detect charging
#HardCharging 1
// the radius when around the obstacle form Left/Right/radius/degree of arcle,           QEparemeter/cm/degree
#RoundArcle 19 19 45 175

// the angle to do rotate/modify/DiffModify when large than this angle,     degree/degree/Xparemeter
#AngleRot 8 2 12

// the diffrence of L/R wheels
//#WheelDiff 10 11

// Walking Speed,               cm/s
#SpeedWalk 60 60 23 75

// speed adjust for X/Y
#SpeedXY 100 100

// the step between walk lines in direction X/Y/C/G/A,  C/G are width of the cutter and grid    cm
// A is the angle of RoutePlan2
#StepLine 30 30 21 7 0

// think as same point when less than this S/L ,                 cm
#StepClose 20 60

// How to set X,Y,angle by RTK    flag/time/angle ,          0,1,2/s/degree
#RtkSet 0 2 5

// less than this will stop and round it, 0 means not work,           cm
#Vision 75

// Magnetic sensor stop mode: 0=stop when detected, 1=stop when not detected
#MagnetStop 0

// the RTK antenna mount postion from the two wheels rotation center point
//#RtkMntDiff 1 30
#RtkMntDiff 0 -30

// the size of the AprilTag,         m
#AprilTagSize 0.22 0.22

// only detect AprilTag inside this range,   angle(degree) distance(cm))
#AprilTagRange 30 300


// the distance to walk when StationOut, >0:RTK type, <0:Visual type

#StationLength 100


// Threshold and frequency of obstacle avoidance,          cm
#AvoidObstacle 60 700


// Speed adjustment limits for testing,          cm/s
#SpeedAdjust 15 10 1

//0 indicates the use of the original stub function, and 1 code uses the latest stub function.

#TestVisionXs 1
