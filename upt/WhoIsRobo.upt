// comment
// this is mower's information or controll center
// my name
#name Mower-Model-0.1

// serial port to 415
// ware-share
//#port /dev/ttyS3
// miniboard
#port /dev/ttyS2

// 0: normal,  1:test all night,  2:display time cost   8/9:special used by programmer
//#testnight 3

// timeout of the 415->X3 transfor
#timeout 3000
 
// my type:  base=0,  RTK+Visual=1,  Visual=2  
#devtype 1

// my IDdevice:  0=base(alarm all cranes's bangs),  >0: cranes(only alarm my bangs)
#myid 0

// my view shift(x,y) and scale(x,y,z)
#window 1600,800,5000,8000
#shift 0,0
#scale 1.0,1.0,-1.0
#angle 0,30,0

// Karlman:    this is a time in milliseconds, long than this, the RTK will reset the myRoboM, less than this will use Karlman filter
#karlman 3000 100 1000

// BorderWidth: the width of grids beside the border from inside
#borderwidth 3


// follows is for developer, change them carefully!!!!!!!!!!!

// move IDdevice,x,y,z
#movediff 12,800,2500,0

// diff type: 0=no-adjust,  1=eu-adjust,  2=
#diff 1

// work mode: realRTK=0, demoRTK=1,  demoMove=2,   3=demoLOG
#mode 2

// view bang lamp or not: 0=no,  1=yes
#lamp 0

// low to high type: 0=nothing, 1=up one RTK, 2=rest all, 3=stop base 2mins
#lower 1

// log type:    0=off,    1=LogLonBug only,    2=LogBug only,    3=both
#logtype 3


// refresh timer: 0:don't refresh whoami,   3-60: refresh timer
// this is for view the upt file's shape
#refresh 300


